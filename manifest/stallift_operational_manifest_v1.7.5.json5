        state_snapshot_protocol: "core.protocols.state_snapshot_protocol",
        system_snapshot_baseline_protocol: "core.protocols.system_snapshot_baseline_protocol",
        file_utilization_protocol: "core.protocols.file_utilization_protocol",
        worklog_protocol: "core.protocols.worklog_protocol",
        review_protocol: "core.protocols.review_protocol",
        artifact_registry_protocol: "core.protocols.artifact_registry_protocol",
        decision_log_protocol: "core.protocols.decision_log_protocol",
        terminology_control_protocol: "core.protocols.terminology_control_protocol",
        ui_execution_protocol: "core.protocols.ui_execution_protocol",
        operational_continuity_protocol: "core.protocols.operational_continuity_protocol",
        security_non_shortcut_protocol: "core.protocols.security_non_shortcut_protocol",
        change_control_protocol_core: "core.protocols.change_control_protocol_core",
        rollback_protocol: "core.protocols.rollback_protocol",
        agency_path_protocol: "core.protocols.agency_path_protocol",
        module_dependencies_protocol: "core.protocols.module_dependencies_protocol",
        naming_conventions_base_kind: "core.protocols.naming_conventions_base_kind",
        minimal_qc_form_protocol: "core.protocols.minimal_qc_form_protocol",
        snapshot_hashing_protocol: "core.protocols.snapshot_hashing_protocol",
        critical_module_escalation_rule: "core.protocols.critical_module_escalation_rule",
        integrity_alert_protocol: "core.protocols.integrity_alert_protocol"
      },
      note: "Dodając nowy protokół CORE, dopisz go tutaj."
    },

    protocol_aliases: {
      purpose: "Aliasowanie starych nazw na kanoniczne protokoły.",
      aliases: {
        "core.worklog_policy": { points_to: "core.protocols.worklog_protocol", note: "ujednolicenie *_protocol" },
        "core.artifact_registry": { points_to: "core.protocols.artifact_registry_protocol", note: "rozróżnienie: plik rejestru vs protokół" },
        "core.decision_log_protocol": { points_to: "core.protocols.decision_log_protocol", note: "bez zmian semantyki" }
      }
    },

    notes: [
      "CORE obowiązuje zawsze.",
      "Moduły uruchamiane tylko, gdy zadanie dotyczy domeny.",
      "QC: wewnętrznie zawsze; emisja tylko dla BUSINESS_SIGNIFICANT, na żądanie lub przy risk_triggered_qc.",
      "Kontynuacja: nie wracamy do zamkniętych tematów; niepewność → pytamy o status.",
      "ID: TASK/ART/DEC/WLOG zdefiniowane centralnie; NNN wyłącznie z id_counters (bez zgadywania)."
    ]
  },

  // === MODULES (domain) ===
  modules: {
    network_udm: {
      module_tag: "network_udm",
      module_importance: "critical",
      dependencies: ["cloudflare_zero_trust"],
      dependencies_semantics_ref: "core.module_system.dependencies_semantics",
      integration_points: [
        { with: "cloudflare_zero_trust", controls: ["egress allow for Connector", "logowanie prób", "rate-limit egress jeśli dotyczy"] }
      ],
      change_control_protocol: {
        purpose: "Standaryzować zmiany firewall/VLAN bez ryzyka odcięcia usług oraz z rollbackiem.",
        change_unit_rule: "Jednostką zmiany jest 1 reguła albo 1 zmiana profilu portu/VLAN; po każdej zmianie test i zapis do worklog.",
        required_outputs_for_firewall_sessions: [
          "State Snapshot (core.protocols.state_snapshot_protocol)",
          "Rules Table (sekcja po sekcji) z kolejnością",
          "Test Plan + wyniki",
          "Rollback Plan (core.protocols.rollback_protocol)"
        ],
        test_minimum_set: [
          "Internet z DOM",
          "Internet z IOT",
          "Internet z SERWER (jeśli ma mieć)",
          "DOM -> SERWER (dozwolone)",
          "IOT -> LAN (blok inicjowania)",
          "EST/REL działa (odpowiedzi wracają)"
        ],
        rollback_rule: "Utrata Internetu/dostępu admin → cofnij ostatnią zmianę (1 unit), potem diagnoza (patrz rollback_protocol)."
      },
      rules_table_schema_firewall: {
        table_columns: [
          "Rule name","Section (LAN IN/LAN LOCAL/INTERNET IN/...)","Action (ACCEPT/DROP/REJECT)",
          "Src network/group","Dst network/group","Protocol/Ports","State (NEW/EST/REL)","Logging (on/off)",
          "Order/priority","Test (jak potwierdzić)"
        ]
      }
    },

    synology_dsm: {
      module_tag: "synology_dsm",
      module_importance: "standard",
      dependencies: ["cloudflare_zero_trust"],
      dependencies_semantics_ref: "core.module_system.dependencies_semantics",
      integration_points: [
        { with: "cloudflare_zero_trust", controls: ["mapowanie cert do usług DSM/Reverse Proxy"], tests: ["brak ostrzeżeń TLS"] }
      ],
      shared_folders_policy: {
        rule_of_thumb: "Folder współdzielony tworzymy tylko dla katalogów głównych (top-level).",
        default_structure: {
          shared_folders_top_level: ["docker","FIRMA","FOTO","RODZINA","ST-APP"],
          subfolders_inside_shared: {
            FIRMA: ["00_INBOX_ROBOCZE","10_PROJEKTY","20_SZABLONY","30_KONTRAHENCI","40_KSIĘGOWOŚĆ","90_ARCHIWUM"],
            docker: ["immich","cloudflared-<nazwa>","<inne_kontenery>"]
          }
        },
        explicit_answer: "Nie: nie wszystkie katalogi mają być 'współdzielone'. Współdzielone są tylko foldery główne.",
        exceptions_when_subfolder_as_shared_is_allowed: [
          "inny protokół/ustawienia udziału (osobny SMB/ACL)",
          "izolacja snapshot/quoty/backup per udział",
          "inne szyfrowanie/WriteOnce na poziomie udziału"
        ],
        recycle_bin_note: "Kosz (#recycle) jest per folder współdzielony; nie rozdrabniać udziałów bez potrzeby."
      }
    },

    power_platform: {
      module_tag: "power_platform",
      module_importance: "auxiliary",
      dependencies: [],
      dependencies_semantics_ref: "core.module_system.dependencies_semantics",
